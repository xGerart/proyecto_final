# Copia este archivo a .env y completa los valores. .env está en .gitignore.

# --- Snowflake (autenticación por par de llaves, sin contraseña) ---
# account identifier: <org>-<cuenta>
SNOWFLAKE_ACCOUNT=xxxxxxx-yyyyyyy
SNOWFLAKE_USER=PSET2_SVC
SNOWFLAKE_ROLE=PSET2_ROLE
SNOWFLAKE_WAREHOUSE=PSET2_WH
SNOWFLAKE_DATABASE=PSET2
SNOWFLAKE_PRIVATE_KEY_FILE=./secrets/snowflake_rsa_key.p8

# --- Fuente: servidor del ERP (llave SSH dedicada con forced command) ---
ERP_SSH_HOST=0.0.0.0
ERP_SSH_USER=ubuntu
ERP_SSH_KEY_FILE=./secrets/kestra_ssh_ed25519

# --- Kestra (usuario de la UI/API) ---
KESTRA_USER=admin@proyecto.local
# 8+ caracteres, mayúscula, minúscula y número
KESTRA_PASSWORD=Cambia-esta-clave-1

# --- Ventana de análisis ---
ANALYSIS_START_DATE=2026-08-20
ANALYSIS_END_DATE=2026-11-25

# --- MLflow ---
# Contraseña del Postgres interno de MLflow (cualquier valor aleatorio)
MLFLOW_DB_PASSWORD=cambia-esto
MLFLOW_TRACKING_URI=http://localhost:5050
MLFLOW_DISABLE_AGENT_HINT=1
# Solo si se borran las respuestas guardadas del LLM en docs/llm/ (notebook 03)
ANTHROPIC_API_KEY=

# --- API ---
# Tag de la imagen publicada por cd.yml (hash del commit) o "local" con `make api-local`
API_TAG=local
# Token de los endpoints protegidos (/modelo/recargar, /respaldo): openssl rand -hex 16
TOKEN_ADMIN=cambia-esto
# true = la API arranca con el interruptor de respaldo activado (regla de negocio)
MODO_RESPALDO=false
